{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/**/*.js",
    "app/**/*.jsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.js",
    "components/**/*.jsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.js",
    "constants/**/*.jsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "context/**/*.js",
    "context/**/*.jsx",
    "context/**/*.ts",
    "context/**/*.tsx",
    "hooks/**/*.js",
    "hooks/**/*.jsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "services/**/*.js",
    "services/**/*.jsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "utils/**/*.js",
    "utils/**/*.jsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
