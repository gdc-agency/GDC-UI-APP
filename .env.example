# remote = org Render URLs (production / organization)
# local  = PC LAN backends (ports 5000–5003)
EXPO_PUBLIC_API_MODE=remote

EXPO_PUBLIC_API_BASE_URL=https://org-gdc-backend.onrender.com
EXPO_PUBLIC_TASK_API_BASE_URL=https://org-task-backend.onrender.com
EXPO_PUBLIC_CHAT_API_BASE_URL=https://org-chat-backend-rey1.onrender.com
EXPO_PUBLIC_ATTENDANCE_API_BASE_URL=https://org-attendence-backend.onrender.com

