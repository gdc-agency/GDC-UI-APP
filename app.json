{
  "expo": {
    "name": "WorkTym",
    "slug": "crmApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/launcher-icon.png",
    "scheme": "worktym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.worktym.app",
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worktym.app",
      "infoPlist": {
        "CFBundleDisplayName": "WorkTym",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set your profile picture.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera for your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiMode": "remote",
      "apiBaseUrl": "https://org-gdc-backend.onrender.com",
      "taskApiBaseUrl": "https://org-task-backend.onrender.com",
      "chatApiBaseUrl": "https://org-chat-backend-rey1.onrender.com",
      "attendanceApiBaseUrl": "https://org-attendence-backend.onrender.com",
      "apiPort": 5000,
      "taskApiPort": 5001,
      "chatApiPort": 5002,
      "attendanceApiPort": 5003,
      "router": {},
      "eas": {
        "projectId": "36cc37ec-7449-40dc-89bc-9014a36ff7f6"
      }
    }
  }
}
